<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>ARTEMIS · Leonardo Life Path</title>
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css" />
  <link rel="stylesheet" href="./style.css" />
</head>
<body>
  <main id="app">
    <section id="globe-shell" aria-label="ARTEMIS Leonardo life path globe">
      <div id="globe"></div>
      <header id="spike-banner">
        <div class="product-label">
          <strong>ARTEMIS · Leonardo Life Path</strong>
          <span>{{PUBLIC_PREVIEW_STATUS}}</span>
          <span class="sequence-note">Dashed links and chevrons show time order, not travel routes.</span>
        </div>
        <div class="banner-actions"><div class="language-switch" role="group" aria-label="Language"><button id="language-en" type="button" aria-pressed="true">EN</button><button id="language-ru" type="button" aria-pressed="false">RU</button></div>{{PUBLIC_PREVIEW_NAV}}</div>
      </header>
      <div id="attribution-status" class="map-note attribution-note"></div>
    </section>

    <aside id="inspector" aria-label="Selected place details" hidden>
      <header class="drawer-header">
        <div>
          <span class="eyebrow">Selected presence</span>
          <h2 id="selection-title">Place details</h2>
        </div>
        <button id="close-details" type="button" aria-label="Close place details">×</button>
      </header>
      <section class="selection-section" aria-labelledby="selection-title">
        <div id="selection-card" class="selection-card empty" tabindex="-1" aria-live="polite">Choose a numbered place on the globe.</div>
      </section>
      <details id="prototype-details" class="prototype-details">
        <summary>Sources, limits and prototype status</summary>
        <div class="prototype-body">
          <p class="source-note">Frozen repository review package. Claims remain draft/rejected; this preview does not query Airtable.</p>
          <dl class="metrics">
            <div><dt>Selected time</dt><dd id="selected-time">—</dd></div>
            <div><dt>World Slice</dt><dd id="world-slice">—</dd></div>
            <div><dt>Corpus status</dt><dd id="corpus-status">—</dd></div>
            <div><dt>Engine</dt><dd id="engine-status">loading</dd></div>
            <div><dt>Terrain</dt><dd id="terrain-status">—</dd></div>
            <div><dt>Startup</dt><dd id="startup-ms">pending</dd></div>
            <div><dt>Frame sample</dt><dd id="frame-sample">pending</dd></div>
          </dl>
          <p id="boundary-status" class="boundary-note"></p>
          <span id="explorer-state" hidden></span>
          <span id="projection-id" hidden></span>
          <span id="deferred-types" hidden></span>
          <span id="primitive-count" hidden></span>
        </div>
      </details>
    </aside>

    <section id="timeline-dock" aria-labelledby="time-mode-title">
      <header class="timeline-subject">
        <span class="eyebrow">Selected object</span>
        <h1>Leonardo da Vinci</h1>
        <p id="path-coverage">Whole-life proof · 1452–1519</p>
      </header>

      <div class="timeline-workspace">
        <div class="timeline-heading">
          <h2 id="time-mode-title">Timeline</h2>
          <div class="mode-switch" role="group" aria-label="Timeline mode">
            <button id="mode-range" type="button" aria-pressed="true">Range</button>
            <button id="mode-scrub" type="button" aria-pressed="false">Scrub</button>
          </div>
        </div>

        <nav id="macro-periods" class="macro-periods" aria-label="Major life periods"></nav>

        <div id="range-controls" class="timeline-mode">
          <div class="timeline-values">
            <label for="range-start">From <output id="range-start-value" for="range-start">—</output></label>
            <label for="range-end">To <output id="range-end-value" for="range-end">—</output></label>
          </div>
          <div class="dual-range" aria-label="Selected calendar interval">
            <input id="range-start" type="range" min="0" max="0" step="1" value="0" />
            <input id="range-end" type="range" min="0" max="0" step="1" value="0" />
          </div>
        </div>

        <div id="scrub-controls" class="timeline-mode scrub-mode" hidden>
          <label class="scrub-cursor" for="scrub-current">Current time
            <output id="scrub-current-value" for="scrub-current">—</output>
          </label>
          <input id="scrub-current" type="range" min="0" max="0" step="1" value="0" />
        </div>
        <nav id="presence-sequence" aria-label="Chronological presences"></nav>
        <p id="temporal-map-status" class="path-status" role="status" aria-live="polite">Loading documented presences…</p>
      </div>

      <div class="timeline-summary">
        <p class="route-note">Dashed links and chevrons show time order, not travel routes.</p>
      </div>
    </section>
  </main>

  <div id="fatal-error" role="alert" hidden></div>

  <script src="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js"></script>
  <script src="./localization.js"></script>
  <script src="./runtime.js"></script>
</body>
</html>
